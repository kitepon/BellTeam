<Window x:Class="BellTeam.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BellTeam.App" Title="BellTeam" Width="1280" Height="820" MinWidth="1100" MinHeight="640" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <!-- Mac round composer buttons: 38 pt, the send arrow turns the line colour when there is nothing to send. -->
    <Style x:Key="CircleButton" TargetType="Button"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,0,1"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Bottom"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="19"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Line}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <CollectionViewSource x:Key="Conversations" Source="{Binding Entries}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
  </Window.Resources>
  <Grid x:Name="Root" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="320" MaxWidth="420"/><ColumnDefinition Width="*" MinWidth="370"/><ColumnDefinition x:Name="InspectorColumn" Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#F1EDFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,10">
          <DockPanel Margin="2,0,0,20"><Button DockPanel.Dock="Right" Click="OpenMenu_Click" Background="#1F767680" BorderThickness="0" Padding="12,6" Foreground="{StaticResource Ink}" ToolTip="追加" AutomationProperties.Name="追加" IsEnabled="{Binding Connected}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xECC8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem Header="メンバーを追加" Click="CreateMember_Click"><MenuItem.Icon><TextBlock Text="&#xE8FA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/></MenuItem.Icon></MenuItem><MenuItem Header="ルームを作成" Click="CreateRoom_Click"><MenuItem.Icon><TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu></Button><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{StaticResource Violet}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="BellTeam" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><Button x:Name="UpdateBadge" Visibility="Collapsed" Click="Updates_Click" Background="#E4DDFB" BorderThickness="0" Padding="6" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="アップデート" AutomationProperties.Name="更新があります。アップデートを開く" AutomationProperties.AutomationId="update-badge"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="99" Padding="{TemplateBinding Padding}"><Grid Width="18" Height="18"><Ellipse Fill="{StaticResource Violet}"/><TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></Button.Template></Button></StackPanel></DockPanel>
          <Border Background="#EFFFFFFF" CornerRadius="10" Padding="11,9"><DockPanel><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><Grid DockPanel.Dock="Right"><TextBlock Text="Ctrl+K" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="&#xE894;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Padding="2" Margin="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" Click="ClearSearch_Click" ToolTip="検索を消去" AutomationProperties.Name="検索を消去"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid><Grid><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="16" ToolTip="メンバー・ルームを検索（Ctrl+K）" AutomationProperties.Name="メンバー・ルームを検索"/><TextBlock Text="メンバー・ルームを検索" FontSize="16" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="14">
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8"><DockPanel><Button x:Name="SettingsNav" DockPanel.Dock="Right" Tag="&#xE713;" Content="設定" Click="Settings_Click" Style="{StaticResource QuietButton}" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="Normal" IsEnabled="{Binding Connected}" ToolTip="設定（Ctrl+,）"/><Button x:Name="SchedulesNav" Tag="&#xE787;" Content="予定" Click="Schedules_Click" Style="{StaticResource QuietButton}" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="Normal" HorizontalAlignment="Left" IsEnabled="{Binding Connected}" ToolTip="予定（Ctrl+2）"/></DockPanel></Border>
          <DockPanel Margin="4,0,4,0"><TextBlock DockPanel.Dock="Right" Text="{Binding OwnerName}" Foreground="{StaticResource Muted}" FontSize="14" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" Margin="0,0,7,0"/><TextBlock Text="{Binding OnlineSummary}" FontSize="14" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
          <Button Content="ログインして始める" Click="Login_Click" Style="{StaticResource PrimaryButton}" Visibility="{Binding NeedsLogin, Converter={StaticResource Visible}}"/>
        </StackPanel>
        <Grid><ListBox x:Name="ConversationList" IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding Source={StaticResource Conversations}}" SelectedItem="{Binding Selected, Mode=OneWay}" SelectionChanged="Conversation_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="メンバーとルーム">
          <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><DockPanel Margin="20,16,20,8"><TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="14" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="14"/></DockPanel></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="57.6"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid Width="57.6" Height="57.6" VerticalAlignment="Center"><local:AvatarTile Entry="{Binding}" Workspace="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Width="57.6" Height="57.6"/><Ellipse x:Name="Presence" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="White" StrokeThickness="2" Fill="{Binding PresenceBrush}" Visibility="{Binding IsMember, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding PresenceLabel}"/></Grid>
              <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><Run Text="{Binding FastModeBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Violet}"/></TextBlock><TextBlock x:Name="Summary" Text="{Binding PreviewText}" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMember}" Value="False"><Setter TargetName="Summary" Property="MaxHeight" Value="15"/></DataTrigger>
              <DataTrigger Binding="{Binding Working}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard><DoubleAnimation Storyboard.TargetName="Presence" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></DataTrigger.ExitActions></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox><TextBlock Text="見つかりませんでした" FontSize="13" Foreground="{StaticResource Muted}" Margin="24,16" VerticalAlignment="Top" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Connected}" Value="True"/><Condition Binding="{Binding Entries.Count}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeBehavior="CurrentAndNext" AutomationProperties.Name="サイドバーの幅"/>
    <Grid x:Name="ConversationArea" Grid.Column="1" Background="{StaticResource ConversationBackground}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="18,12">
        <Button DockPanel.Dock="Right" Content="&#xE8A0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="Inspector_Click" ToolTip="詳細パネル（Ctrl+Shift+I）" AutomationProperties.Name="詳細パネル"/>
        <Button DockPanel.Dock="Right" Content="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="Export_Click" IsEnabled="{Binding HasSelection}" ToolTip="会話を書き出す" AutomationProperties.Name="会話を書き出す"/>
        <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"><local:AvatarTile Entry="{Binding Selected}" Workspace="{Binding}" Width="34" Height="34" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="⚡ ファスト" FontSize="13" Foreground="{StaticResource Violet}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding SelectedFastMode, Converter={StaticResource Visible}}" AutomationProperties.Name="ファストモード中"/></StackPanel><TextBlock Text="{Binding ConversationSubtitle}" FontSize="14" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
      </DockPanel>
      <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,20,18,18" AutomationProperties.Name="会話" AllowDrop="True" PreviewDragOver="Images_DragOver" Drop="Images_Drop">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=MessageScroll}"><StackPanel VerticalAlignment="Bottom">
          <Button Content="以前のメッセージを読む" Visibility="{Binding HasMore, Converter={StaticResource Visible}}" Click="Older_Click"/>
          <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><local:MessageCard Message="{Binding Message}" Workspace="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Author="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,17"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <!-- Mac queueStrip: one line per running or queued delivery; in a room each member's line has its own stop button. -->
          <Border x:Name="QueueStrip" Background="#A6E8E0FF" CornerRadius="16" Padding="14,9.5" Visibility="{Binding HasActivity, Converter={StaticResource Visible}}" AutomationProperties.Name="処理中">
            <ItemsControl ItemsSource="{Binding ActivityRows}"><ItemsControl.ItemTemplate><DataTemplate>
              <DockPanel Margin="0,4.5">
                <Button DockPanel.Dock="Right" Content="{Binding StopLabel}" Tag="{Binding}" Click="StopBot_Click" Margin="8,0,0,0" Padding="10,3" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Ink}" IsEnabled="{Binding DataContext.StopEnabled, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Name, StringFormat={}{0}の今の動作を止める}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding StopBotId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <local:Spinner DockPanel.Dock="Left" Stroke="{StaticResource Violet}" Margin="0,0,9,0"/>
                <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Violet}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Border>
        </StackPanel></Grid>
      </ScrollViewer>
      <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450" Margin="30"><TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52" Foreground="{StaticResource Violet}" HorizontalAlignment="Center" Margin="0,0,0,18"/><TextBlock x:Name="WelcomeTitle" FontSize="29" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Text="チームと、同じデスクで。"/><TextBlock x:Name="WelcomeNote" FontSize="16" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" Text="左のメンバーやルームを選んで、会話を始めましょう。"/><StackPanel x:Name="WelcomeHints" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" TextElement.FontSize="14" TextElement.Foreground="{StaticResource Muted}"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="検索  Ctrl+K" Margin="0,0,25,0"/><TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="送信  Enter"/></StackPanel></StackPanel>
      <!-- Mac ConversationContent states: loading, nothing said yet, and a first read that failed. -->
      <local:Spinner x:Name="LoadingSpinner" Grid.Row="1" Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" Stroke="{StaticResource Muted}" Visibility="Collapsed"/>
      <StackPanel x:Name="EmptyConversation" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="30,100,30,0" Visibility="Collapsed"><local:AvatarTile Entry="{Binding Selected}" Workspace="{Binding}" Width="72" Height="72" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,13,0,0"/><TextBlock Text="最初のメッセージを送ってみてね。" FontSize="15" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,13,0,0"/></StackPanel>
      <StackPanel x:Name="FailedConversation" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="30,60,30,0" Visibility="Collapsed"><TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="会話を読み込めませんでした" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="再読み込みしてください。" FontSize="15" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0"/><Button Content="再読み込み" Click="Reload_Click" HorizontalAlignment="Center" Margin="0,16,0,0" AutomationProperties.Name="再読み込み"/></StackPanel>
      <Button x:Name="NewMessagesButton" Grid.Row="1" Content="最新へ ↓" AutomationProperties.AutomationId="scroll-to-latest" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="NewMessages_Click"/>
      <!-- Composer band (Mac composer): notices and attachments sit above the reply target and the input. -->
      <Border Grid.Row="2" Background="#E9E7E6"><StackPanel Margin="15,11,15,8">
        <Border x:Name="StopNoticeBox" CornerRadius="16" Padding="14" Margin="0,0,0,8" Background="#A6E8E0FF" Visibility="Collapsed"><TextBlock x:Name="StopNoticeText" FontSize="14" TextWrapping="Wrap" AutomationProperties.Name="停止の結果"/></Border>
        <TextBlock Text="{Binding SendError}" Foreground="#FF3B30" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.Name="送信の失敗"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="添付画像"><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,8,10,8" Width="60" Height="60"><Border CornerRadius="12" ClipToBounds="True"><Image Source="{Binding Preview}" Stretch="UniformToFill" Width="60" Height="60"><Image.Clip><RectangleGeometry Rect="0,0,60,60" RadiusX="12" RadiusY="12"/></Image.Clip></Image></Border>
            <Button Tag="{Binding Data}" Click="RemoveImage_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Padding="0" Width="18" Height="18" ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}"><Button.Template><ControlTemplate TargetType="Button"><Grid><Ellipse Fill="White" Margin="2"/><Ellipse Fill="#BF21293D" Margin="1.5"/><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></Button.Template></Button></Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Button x:Name="ReplyTargetButton" Click="ReplyTarget_Click" HorizontalAlignment="Center" Margin="0,0,0,8" Padding="0" Visibility="{Binding IsRoom, Converter={StaticResource Visible}}" AutomationProperties.Name="返信先"><Button.Template><ControlTemplate TargetType="Button"><Border Background="#BFE8E0FF" CornerRadius="99" Padding="11,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Violet}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding ReplyTargetLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Violet}" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Violet}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel></Border></ControlTemplate></Button.Template></Button>
        <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="24" Padding="8,5">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Violet}" Click="Attach_Click" IsEnabled="{Binding CanAttach}" Style="{StaticResource QuietButton}" Width="40" Height="40" Padding="0" Margin="0,0,12,0" VerticalAlignment="Bottom" ToolTip="画像ファイルを添付。ここへドロップ、入力欄へ貼り付けもできます" AutomationProperties.Name="画像を添付"/>
            <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,12,0"><TextBox x:Name="Composer" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="24" MaxHeight="124" Margin="0,8" Padding="0" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" FontSize="18" PreviewKeyDown="Composer_KeyDown" AutomationProperties.Name="メッセージ" ToolTip="Enterで送信・Shift+Enterで改行" AllowDrop="True" PreviewDragOver="Images_DragOver" Drop="Images_Drop"/><TextBlock Text="メッセージを入力…" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,8,0,0" IsHitTestVisible="False" VerticalAlignment="Top"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DraftText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <Button x:Name="StopCurrentButton" Grid.Column="2" Style="{StaticResource CircleButton}" Background="#FF3B30" Margin="0,0,12,1" Click="StopCurrent_Click" IsEnabled="{Binding StopEnabled}" Visibility="{Binding CurrentBotCanStop, Converter={StaticResource Visible}}" ToolTip="今の動作を止める" AutomationProperties.Name="今の動作を止める" AutomationProperties.AutomationId="stop-current-bot"><Border Width="13" Height="13" CornerRadius="2.5" Background="White"/></Button>
            <Button Grid.Column="3" Style="{StaticResource CircleButton}" Background="{StaticResource Violet}" IsEnabled="{Binding CanSend}" Click="Send_Click" ToolTip="送信（Enter）" AutomationProperties.Name="{Binding SendLabel}"><TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" FontWeight="Bold" Foreground="White"/></Button>
          </Grid>
        </Border>
      </StackPanel></Border>
    </Grid>
    <Border x:Name="Inspector" Grid.Column="2" Background="#99FFFFFF" BorderBrush="#E0DBE8" BorderThickness="1,0,0,0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ProfileVisible, Converter={StaticResource Visible}}"><local:ProfileView x:Name="ProfilePanel" Workspace="{Binding}" MaxWidth="760" HorizontalAlignment="Center"/></ScrollViewer>
        <local:ScreenView x:Name="ScreenPanel" Workspace="{Binding}" Visibility="{Binding ScreenVisible, Converter={StaticResource Visible}}"/>
      </Grid>
    </Border>
    <Border x:Name="PageArea" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource ConversationBackground}" Visibility="Collapsed"><ContentControl x:Name="PageHost"/></Border>
    <StackPanel x:Name="ErrorStrip" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#F2FFFFFF"><DockPanel><Button x:Name="ConnectionButton" DockPanel.Dock="Right" Content="接続先" Click="Connection_Click" Margin="0,3,8,3" Padding="12,4" Visibility="Collapsed" AutomationProperties.Name="接続先"/><Button x:Name="ReconnectButton" DockPanel.Dock="Right" Content="再接続" Click="Reconnect_Click" Margin="8,3" Padding="12,4" Visibility="Collapsed" AutomationProperties.Name="再接続"/><TextBlock Text="{Binding ConnectionError}" TextAlignment="Center" VerticalAlignment="Center" Foreground="#AF384D" TextWrapping="Wrap" Margin="12,3" FontSize="14" AutomationProperties.Name="接続の失敗"/></DockPanel><TextBlock Text="{Binding ActionError}" Foreground="#AF384D" TextWrapping="Wrap" Margin="12,3" FontSize="14" AutomationProperties.Name="操作の失敗"/></StackPanel>
    <Grid x:Name="UpdateSheet" Grid.RowSpan="2" Grid.ColumnSpan="3" Panel.ZIndex="20" Visibility="Collapsed" Background="#66000000" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
      <!-- Mac bellEditorSheet: min 720x540, ideal 820x680, shrinks to fit the window. -->
      <Border x:Name="SheetFrame" Margin="24" MinWidth="720" MinHeight="540" MaxWidth="820" MaxHeight="680" Background="#F2F2F7" CornerRadius="14" ClipToBounds="True" AutomationProperties.Name="アップデート">
        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/></Border.Effect>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="52" Background="#F2F2F7">
            <Button x:Name="UpdateSheetClose" Content="閉じる" Click="UpdateSheetClose_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Padding="10,6" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Violet}" FontSize="14" AutomationProperties.Name="閉じる"/>
            <TextBlock x:Name="SheetTitle" Text="アップデート" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          </Grid>
          <Border DockPanel.Dock="Top" Height="1" Background="#E6E6EB"/>
          <ContentControl x:Name="UpdateSheetHost"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
