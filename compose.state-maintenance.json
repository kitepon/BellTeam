{
  "services": {
    "state-maintenance": {
      "image": "${BELLTEAM_SERVER_IMAGE:?select the accepted server image}",
      "pull_policy": "never",
      "user": "0:0",
      "entrypoint": [
        "/usr/bin/env",
        "-i",
        "PATH=/usr/local/bin:/usr/bin:/bin",
        "/usr/local/bin/node",
        "/app/src/server-state-transfer.mjs"
      ],
      "command": [
        "to-server"
      ],
      "init": true,
      "read_only": true,
      "network_mode": "none",
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cpus": 1,
      "mem_limit": "2g",
      "memswap_limit": "2g",
      "pids_limit": 512,
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,size=64m"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${BELLTEAM_LEGACY_DATA:?select the stopped legacy data source}",
          "target": "/srv/bellteam-legacy",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_LEGACY_DATA:?select the stopped legacy data source}",
          "target": "/srv/bellteam",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_STATE_PARENT:?select the prepared private state parent}/state",
          "target": "/srv/bellteam/state",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_STATE_PARENT:?select the prepared private state parent}/rooms",
          "target": "/srv/bellteam/rooms",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_STATE_PARENT:?select the prepared private state parent}/owner",
          "target": "/srv/bellteam/owner",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_STATE_PARENT:?select the prepared private state parent}/logs",
          "target": "/srv/bellteam/logs",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_STATE_PARENT:?select the prepared private state parent}/bellteam-settings",
          "target": "/srv/bellteam/shared/tools/bellteam-settings",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_STATE_PARENT:?select the prepared private state parent}/apns",
          "target": "/srv/bellteam/shared/tools/apns",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${BELLTEAM_MAINTENANCE_BACKUP_PARENT:?select the private backup parent}",
          "target": "/srv/bellteam-maintenance-backups",
          "bind": {
            "create_host_path": false
          }
        }
      ]
    }
  }
}
