<Window x:Class="BellTeam.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BellTeam.App" Title="BellTeam" Width="1280" Height="820" MinWidth="1100" MinHeight="640" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <CollectionViewSource x:Key="Conversations" Source="{Binding Entries}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
  </Window.Resources>
  <Grid x:Name="Root" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="320"/><ColumnDefinition Width="*" MinWidth="370"/><ColumnDefinition x:Name="InspectorColumn" Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#F1EDFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,10">
          <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Style="{StaticResource IconButton}" Click="OpenMenu_Click" ToolTip="追加" AutomationProperties.Name="追加" IsEnabled="{Binding Connected}"><Button.ContextMenu><ContextMenu><MenuItem Header="メンバーを追加" Click="CreateMember_Click"/><MenuItem Header="ルームを作成" Click="CreateRoom_Click"/></ContextMenu></Button.ContextMenu></Button><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{StaticResource Violet}" FontSize="26" Margin="0,0,10,0"/><TextBlock Text="BellTeam" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DockPanel>
          <Border Background="#EFFFFFFF" CornerRadius="10" Padding="11,9"><DockPanel><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock DockPanel.Dock="Right" Text="Ctrl K" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Grid><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" ToolTip="メンバー・ルームを検索（Ctrl+K）" AutomationProperties.Name="メンバー・ルームを検索"/><TextBlock Text="メンバー・ルームを検索" FontSize="14" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="14">
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10"><DockPanel><Button x:Name="SettingsNav" DockPanel.Dock="Right" Tag="&#xE713;" Content="設定" Click="Settings_Click" Style="{StaticResource QuietButton}" IsEnabled="{Binding Connected}"/><Button x:Name="SchedulesNav" Tag="&#xE787;" Content="予定" Click="Schedules_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" IsEnabled="{Binding Connected}"/></DockPanel></Border>
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding OwnerName}" Foreground="{StaticResource Muted}" FontSize="14" MaxWidth="70" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0"/><Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="Reconnect_Click" Style="{StaticResource IconButton}" ToolTip="再接続" AutomationProperties.Name="再接続"/><Button DockPanel.Dock="Right" Content="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="Connection_Click" Style="{StaticResource IconButton}" ToolTip="接続先" AutomationProperties.Name="接続先"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" Margin="4,0,7,0"/><TextBlock Text="{Binding OnlineSummary}" FontSize="14" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
        </StackPanel>
        <ListBox x:Name="ConversationList" IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding Source={StaticResource Conversations}}" SelectedItem="{Binding Selected, Mode=OneWay}" SelectionChanged="Conversation_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="メンバーとルーム">
          <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><DockPanel Margin="20,16,20,8"><TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="14" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="14"/></DockPanel></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid Width="48" Height="48"><local:AvatarTile Entry="{Binding}" Workspace="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Width="48" Height="48"/><Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="White" StrokeThickness="2" Fill="{Binding PresenceBrush}" Visibility="{Binding IsMember, Converter={StaticResource Visible}}"/></Grid>
              <StackPanel Grid.Column="1" Margin="9,0,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⚡ ファスト" FontSize="12" Foreground="{StaticResource Violet}" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding FastMode, Converter={StaticResource Visible}}" AutomationProperties.Name="ファストモード中"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid x:Name="ConversationArea" Grid.Column="1" Background="{StaticResource ConversationBackground}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="18,12">
        <Button DockPanel.Dock="Right" Content="&#xE8A0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="Inspector_Click" ToolTip="詳細パネル（Ctrl+Shift+I）" AutomationProperties.Name="詳細パネル"/>
        <Button DockPanel.Dock="Right" Content="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="Export_Click" IsEnabled="{Binding HasSelection}" ToolTip="会話を書き出す" AutomationProperties.Name="会話を書き出す"/>
        <TextBlock DockPanel.Dock="Right" Text="⚡ ファスト" FontSize="13" Foreground="{StaticResource Violet}" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding Selected.FastMode, Converter={StaticResource Visible}}" AutomationProperties.Name="ファストモード中"/>
        <DockPanel><local:AvatarTile Entry="{Binding Selected}" Workspace="{Binding}" Width="34" Height="34" Margin="0,0,10,0" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ConversationSubtitle}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
      </DockPanel>
      <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,20,18,18" AutomationProperties.Name="会話" AllowDrop="True" PreviewDragOver="Images_DragOver" Drop="Images_Drop">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=MessageScroll}"><StackPanel VerticalAlignment="Bottom">
          <Button Content="以前のメッセージを読む" Visibility="{Binding HasMore, Converter={StaticResource Visible}}" Click="Older_Click"/>
          <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><local:MessageCard Message="{Binding Message}" Workspace="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Author="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,17"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Border Background="#EDE6FF" CornerRadius="18" Padding="14" Visibility="{Binding HasActivity, Converter={StaticResource Visible}}"><TextBlock Text="{Binding ActivityText}" FontSize="14" Foreground="{StaticResource Violet}" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
        </StackPanel></Grid>
      </ScrollViewer>
      <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450" Margin="30"><TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" Foreground="{StaticResource Violet}" HorizontalAlignment="Center" Margin="0,0,0,22"/><TextBlock x:Name="WelcomeTitle" FontSize="26" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="WelcomeNote" FontSize="16" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel>
      <Button x:Name="NewMessagesButton" Grid.Row="1" Content="新着メッセージ ↓" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="NewMessages_Click"/>
      <StackPanel Grid.Row="2" Margin="16,10,16,16">
        <Expander Header="返信するメンバーを選択" Visibility="{Binding IsRoom, Converter={StaticResource Visible}}"><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReplyMembers}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander>
        <TextBlock Text="{Binding SendError}" Foreground="#AF384D" TextWrapping="Wrap" Margin="0,5" AutomationProperties.Name="送信の失敗"/>
        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="3" Padding="4" BorderBrush="#DCD7E5" BorderThickness="1"><StackPanel Width="100"><Image Source="{Binding Preview}" Height="64" Stretch="Uniform"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/><Button Content="取り外す" Tag="{Binding Data}" Click="RemoveImage_Click" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="5">
          <DockPanel><Button DockPanel.Dock="Left" Content="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="Attach_Click" IsEnabled="{Binding CanAttach}" Style="{StaticResource IconButton}" ToolTip="画像を添付" AutomationProperties.Name="画像を添付" VerticalAlignment="Bottom"/><Button DockPanel.Dock="Right" Content="{Binding SendLabel}" Tag="&#xE724;" IsEnabled="{Binding CanSend}" Click="Send_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
            <Grid><TextBox x:Name="Composer" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="150" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" FontSize="18" PreviewKeyDown="Composer_KeyDown" AutomationProperties.Name="メッセージ" ToolTip="Enterで送信・Shift+Enterで改行" AllowDrop="True" PreviewDragOver="Images_DragOver" Drop="Images_Drop"/><TextBlock Text="メッセージを入力…" FontSize="18" Foreground="{StaticResource Muted}" Margin="12,10,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DraftText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
    <Border x:Name="Inspector" Grid.Column="2" Background="#FFFEFF" BorderBrush="#E0DBE8" BorderThickness="1,0,0,0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ProfileVisible, Converter={StaticResource Visible}}"><local:ProfileView Workspace="{Binding}"/></ScrollViewer>
        <Grid Visibility="{Binding ScreenVisible, Converter={StaticResource Visible}}" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="プロフィールに戻る" Click="Profile_Click"/><Button Content="再読込" Click="Screen_Click"/></WrapPanel><TextBox Grid.Row="1" Text="{Binding Screen, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Botの画面"/><TextBlock Grid.Row="2" Text="{Binding ScreenStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="5"/></Grid>
      </Grid>
    </Border>
    <Border x:Name="PageArea" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource ConversationBackground}" Visibility="Collapsed"><ContentControl x:Name="PageHost"/></Border>
    <StackPanel x:Name="ErrorStrip" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"><TextBlock Text="{Binding ConnectionError}" Foreground="#AF384D" TextWrapping="Wrap" Margin="12,3" FontSize="14" AutomationProperties.Name="接続の失敗"/><TextBlock Text="{Binding ActionError}" Foreground="#AF384D" TextWrapping="Wrap" Margin="12,3" FontSize="14" AutomationProperties.Name="操作の失敗"/></StackPanel>
  </Grid>
</Window>
