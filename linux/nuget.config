<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- login-billing 0.18.8 is accepted by Mint (a product ships on it after Mint conformity check of its embedding): linux/fetch-login-billing.sh puts the sha256-checked package here. -->
    <add key="login-billing-local" value="packages-local" />
  </packageSources>
</configuration>
