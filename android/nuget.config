<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- login-billing 0.19.3 is accepted by Mint (a product ships on it after Mint conformity check of its embedding): android/fetch-login-billing.sh puts the sha256-checked package here. -->
    <add key="login-billing-local" value="packages-local" />
  </packageSources>
  <!-- Kitepon.LoginBilling.* comes only from the local, sha256-checked folder; a same-id package on nuget.org is never restored. -->
  <packageSourceMapping>
    <packageSource key="login-billing-local">
      <package pattern="Kitepon.LoginBilling.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
