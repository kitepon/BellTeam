<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- login-billing 0.22.1 (contract 1.50, one parent, the QR link, every private address in the QR), accepted by Mint 2026-11-24: android/fetch-login-billing.sh puts the sha256-checked package here. -->
    <add key="login-billing-local" value="packages-local" />
  </packageSources>
  <!-- Kitepon.LoginBilling.* comes only from the local, sha256-checked folder; a same-id package on nuget.org is never restored. -->
  <packageSourceMapping>
    <packageSource key="login-billing-local">
      <package pattern="Kitepon.LoginBilling.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
