<?xml version="1.0" encoding="utf-8"?>
<!-- Template for the Microsoft Store package. scripts/package-windows-store.ps1 fills the {…} values from Partner Center (Product identity). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" IgnorableNamespaces="uap rescap">
  <Identity Name="{IdentityName}" Publisher="{Publisher}" Version="{Version}" ProcessorArchitecture="{Architecture}" />
  <Properties>
    <DisplayName>BellTeam</DisplayName>
    <PublisherDisplayName>{PublisherDisplayName}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="ja-JP" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="BellTeam.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="BellTeam" Description="BellTeam" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Tap target of the closed-app update toast sent through WNS: bellteam-update:?server=<origin>. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="bellteam-update">
            <uap:DisplayName>BellTeam Update</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
