<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <!-- Same assembly name as the Windows and Linux apps: BellTeam.Core's InternalsVisibleTo("BellTeam") and avares://BellTeam/ resolve. -->
    <AssemblyName>BellTeam</AssemblyName>
    <ApplicationId>dev.kitepon.bellbot</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.33</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Fast Deployment keeps assemblies outside the APK and breaks after pm clear; embed them so a clean install always starts. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../linux/BellTeam.Linux/*.cs" Exclude="../../linux/BellTeam.Linux/Program.cs;../../linux/BellTeam.Linux/App.cs;../../linux/BellTeam.Linux/MainWindow*.cs;../../linux/BellTeam.Linux/Launcher*.cs;../../linux/BellTeam.Linux/*Render.cs;../../linux/BellTeam.Linux/*Fixture.cs;../../linux/BellTeam.Linux/SingleInstance.cs;../../linux/BellTeam.Linux/LinuxAccountAbxAccount.cs;../../linux/BellTeam.Linux/LinuxAccountCard.cs;../../linux/BellTeam.Linux/LinuxAccountGate.cs;../../linux/BellTeam.Linux/LinuxAccountStore.cs" LinkBase="LinuxViews" />
    <ProjectReference Include="../../windows/BellTeam.Core/BellTeam.Core.csproj" />
    <EmbeddedResource Include="../../ios/BellBot/BellBot/Assets.xcassets/AppIcon.appiconset/bellbot-icon.png" LogicalName="BellTeam.png" />
    <EmbeddedResource Include="../../ios/BellBot/BellBot/Assets.xcassets/BellPortrait.imageset/bell-portrait.png" LogicalName="BellPortrait.png" />
    <EmbeddedResource Include="../../docs/server-installation.md" LogicalName="server-installation.md" />
    <EmbeddedResource Include="../../services/subscriptions/product.json" LogicalName="product.json" />
    <AvaloniaResource Include="../../linux/BellTeam.Linux/Theme.axaml" Link="Theme.axaml" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.Views" />
    <!-- a520a: the 決裁箱 client is the Linux host part (LinuxAccountAbxHost.cs, linked above) over Kitepon.ApprovalBox.Client; only the account (AndroidApprovalBoxAccount) is Android's. libdatachannel v0.24.6 per ABI: android/native/README.md. -->
    <AndroidNativeLibrary Include="../native/prebuilt/arm64-v8a/libdatachannel.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="../native/prebuilt/x86_64/libdatachannel.so" Abi="x86_64" />
    <PackageReference Include="Kitepon.ApprovalBox.Client" Version="0.5.4" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <!-- a540 (contract 1.36, the local form): Google sign-in, the request QR, this phone's own Play purchase and the answer to another device's QR through the library's android part. 0.21.1 (contract 1.48, with Apple's web sign-in) is accepted (Mint; its scanner reads the local-form QR lbq4:). -->
    <PackageReference Include="Kitepon.LoginBilling.Android" Version="0.24.1" />
    <!-- Approving another device: Google's code scanner reads the QR (Play services, no camera permission of ours). -->
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.17" />
    <!-- The binding gives the QR text only (LocalRequest.Qr); this pure managed encoder (MIT) draws it. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Firebase client settings from the Firebase console (Sielo, a379). Without the file the app builds and runs, and push registration stays off. -->
    <GoogleServicesJson Include="google-services.json" Condition="Exists('google-services.json')" />
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
</Project>
