<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BellTeam</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.1</Version>
    <ApplicationIcon>Assets/BellTeam.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../ios/BellBot/BellBot/Assets.xcassets/AppIcon.appiconset/bellbot-icon.png" Link="Assets/BellTeam.png" />
    <!-- The Mac app bundles the same three files for its server setup screen. -->
    <EmbeddedResource Include="../../ios/BellBot/BellBot/Assets.xcassets/BellPortrait.imageset/bell-portrait.png" LogicalName="BellPortrait.png" />
    <!-- The BellTeam app icon (the same image as Apple) on the first screen. -->
    <EmbeddedResource Include="../../ios/BellBot/BellBot/Assets.xcassets/AppIcon.appiconset/bellbot-icon.png" LogicalName="BellTeamIcon.png" />
    <EmbeddedResource Include="../../docs/server-installation.md" LogicalName="server-installation.md" />
    <EmbeddedResource Include="../../services/subscriptions/product.json" LogicalName="product.json" />
    <InternalsVisibleTo Include="BellTeam.Tests" />
    <!-- a540: the Desktop Google client's secret comes from the build's environment (the install script reads it from the host vault); it is never in a commit. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(BELLTEAM_GOOGLE_DESKTOP_SECRET)' != ''">
      <_Parameter1>GoogleDesktopSecret</_Parameter1>
      <_Parameter2>$(BELLTEAM_GOOGLE_DESKTOP_SECRET)</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="BellTeam.UiChecks" />
    <ProjectReference Include="../BellTeam.Core/BellTeam.Core.csproj" />
    <PackageReference Include="Kitepon.ApprovalBox.Client" Version="0.5.2" />
    <!-- The native engine of the package's peer adapter (libdatachannel, library name "datachannel"): the host ships it (windows/native/README.md). -->
    <None Include="../native/prebuilt/win-x64/datachannel.dll" Condition="'$(RuntimeIdentifier)' != 'win-arm64'" Link="datachannel.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Kitepon.LoginBilling.Desktop" Version="0.23.1" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
