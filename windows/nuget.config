<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- a487: the login-billing C# desktop part is a development release until Airi's final audit; Mint's pin replaces this folder with the published package. -->
    <add key="login-billing-local" value="packages-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Kitepon.LoginBilling.* restores only from the project's own folder, so a same-id package on nuget.org can never be picked (Mint N13). -->
  <packageSourceMapping>
    <packageSource key="login-billing-local">
      <package pattern="Kitepon.LoginBilling.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
