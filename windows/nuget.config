<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- a487: the login-billing C# desktop part is a development release until Airi's final audit; Mint's pin replaces this folder with the published package. -->
    <add key="login-billing-local" value="packages-local" />
    <!-- Kitepon.ApprovalBox.Client: exact version, sha256 checked against the release client-dotnet-v0.5.3 of kitepon/approval-box-apps (a1ecb32df13d27aff9527159b97d92747b7cf5caf4679e70e810881077d21b77) (Mint's pin rules). -->
    <add key="approval-box-client-local" value="packages-approval-box" />
  </packageSources>
  <!-- Kitepon.LoginBilling.* comes only from the local, sha256-checked folder; a same-id package on nuget.org is never restored. -->
  <packageSourceMapping>
    <packageSource key="login-billing-local">
      <package pattern="Kitepon.LoginBilling.*" />
    </packageSource>
    <packageSource key="approval-box-client-local">
      <package pattern="Kitepon.ApprovalBox.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
