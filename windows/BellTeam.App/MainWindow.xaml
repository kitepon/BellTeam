<Window x:Class="BellTeam.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BellTeam.App" Title="BellTeam" Width="1280" Height="820" MinWidth="1100" MinHeight="640" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <CollectionViewSource x:Key="Conversations" Source="{Binding Entries}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
  </Window.Resources>
  <Grid x:Name="Root" Background="#FAF9FC">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="320"/><ColumnDefinition Width="*" MinWidth="370"/><ColumnDefinition x:Name="InspectorColumn" Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#F0ECF7" BorderBrush="#E0DBE8" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,10">
          <TextBlock Text="✦  BellTeam" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="メンバー・ルームを検索（Ctrl+K）" AutomationProperties.Name="メンバー・ルームを検索"/>
          <TextBlock Text="メンバー・ルームを検索  Ctrl+K" Foreground="{StaticResource Muted}" FontSize="12" Margin="3,6,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="14">
          <Button Content="ルームを作成" Click="CreateRoom_Click" IsEnabled="{Binding Connected}"/>
          <Button Content="接続先" Click="Connection_Click" AutomationProperties.Name="接続先"/>
          <Button Content="再接続" Click="Reconnect_Click"/>
          <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="5,10,5,0"/>
        </StackPanel>
        <ListBox x:Name="ConversationList" ItemsSource="{Binding Source={StaticResource Conversations}}" SelectedItem="{Binding Selected, Mode=OneWay}" SelectionChanged="Conversation_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="メンバーとルーム">
          <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="16,16,0,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <local:AvatarTile Entry="{Binding}" Workspace="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Width="40" Height="40" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="20,16">
        <Button DockPanel.Dock="Right" Content="詳細" Click="Inspector_Click" ToolTip="詳細パネルを表示・非表示（Ctrl+Shift+I）"/>
        <Button DockPanel.Dock="Right" Content="会話を書き出す" Click="Export_Click" IsEnabled="{Binding HasSelection}"/>
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,14" AutomationProperties.Name="会話" AllowDrop="True" PreviewDragOver="Images_DragOver" Drop="Images_Drop">
        <StackPanel>
          <Button Content="以前のメッセージを読む" Visibility="{Binding HasMore, Converter={StaticResource Visible}}" Click="Older_Click"/>
          <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><local:MessageCard Message="{Binding Message}" Workspace="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Author="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="16,10,16,16">
        <Expander Header="返信するメンバーを選択" Visibility="{Binding IsRoom, Converter={StaticResource Visible}}"><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReplyMembers}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander>
        <TextBlock Text="{Binding SendError}" Foreground="#AF384D" TextWrapping="Wrap" Margin="0,5" AutomationProperties.Name="送信の失敗"/>
        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="3" Padding="4" BorderBrush="#DCD7E5" BorderThickness="1"><StackPanel Width="100"><Image Source="{Binding Preview}" Height="64" Stretch="Uniform"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/><Button Content="取り外す" Tag="{Binding Data}" Click="RemoveImage_Click" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <TextBox x:Name="Composer" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" MaxHeight="180" VerticalScrollBarVisibility="Auto" FontSize="18" PreviewKeyDown="Composer_KeyDown" AutomationProperties.Name="メッセージ" AllowDrop="True" PreviewDragOver="Images_DragOver" Drop="Images_Drop"/>
        <DockPanel Margin="0,7,0,0"><Button DockPanel.Dock="Right" Content="{Binding SendLabel}" IsEnabled="{Binding CanSend}" Click="Send_Click" Background="#E8E0F2"/><Button DockPanel.Dock="Left" Content="画像を添付" Click="Attach_Click" IsEnabled="{Binding CanAttach}"/><TextBlock Text="送信  Enter    改行  Shift+Enter" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
      </StackPanel>
    </Grid>
    <Border x:Name="Inspector" Grid.Column="2" Background="#FFFEFF" BorderBrush="#E0DBE8" BorderThickness="1,0,0,0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ProfileVisible, Converter={StaticResource Visible}}"><StackPanel Margin="22"><local:AvatarTile Entry="{Binding Selected}" Workspace="{Binding}" Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,12"/><TextBox Text="{Binding Profile, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="18" BorderThickness="0" Background="Transparent" AutomationProperties.Name="プロフィール"/><Button Content="Botの画面を見る" Click="Screen_Click" Visibility="{Binding CanShowScreen, Converter={StaticResource Visible}}"/><Button Content="{Binding EditLabel}" Click="Edit_Click" IsEnabled="{Binding HasSelection}"/></StackPanel></ScrollViewer>
        <Grid Visibility="{Binding ScreenVisible, Converter={StaticResource Visible}}" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="プロフィールに戻る" Click="Profile_Click"/><Button Content="再読込" Click="Screen_Click"/></WrapPanel><TextBox Grid.Row="1" Text="{Binding Screen, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Botの画面"/><TextBlock Grid.Row="2" Text="{Binding ScreenStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="5"/></Grid>
      </Grid>
    </Border>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Background="#FFF1F3"><TextBlock Text="{Binding ConnectionError}" Foreground="#AF384D" TextWrapping="Wrap" Margin="12,3" AutomationProperties.Name="接続の失敗"/><TextBlock Text="{Binding ActionError}" Foreground="#AF384D" TextWrapping="Wrap" Margin="12,3" AutomationProperties.Name="操作の失敗"/></StackPanel>
  </Grid>
</Window>
