#!/usr/bin/env python3
"""auth exec COMMAND... [-- ARGS...]: runs the command with the secret from the authentication module.
The item is named by COMMAND (as typed); ARGS are appended at run time and never take part in authorization.
Same line protocol as the old broker; the module reads the caller's folder itself on the container socket, and takes the folder sent here on the host socket."""
import json, os, shutil, signal, socket, subprocess, sys, tempfile, threading, time

SOCK = os.environ.get("AUTH_SOCK") or "/srv/bellteam/shared/tools/auth-mediation/container.sock"


def ask(request):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(60)
    for wait in range(50):  # a full listen queue answers EAGAIN at once on a socket with a timeout (a burst of agent clients, 2026-11-28); queue up for at most 5 s
        try:
            s.connect(SOCK)
            break
        except BlockingIOError:
            if wait == 49:
                raise
            time.sleep(0.1)
    s.sendall((json.dumps(request) + "\n").encode())
    return json.loads(s.makefile().readline())


def scratch():
    """Owner-only folder for this run: RAM (/dev/shm) when there is one."""
    return tempfile.mkdtemp(prefix="auth-", dir="/dev/shm" if os.path.isdir("/dev/shm") else None)


def hand_over(fields, d, agents):
    """Turn the module's fields into the command's environment (labels: VAR, file:VAR, ssh-key)."""
    env = {}
    for label, value in fields.items():
        if label.startswith("file:"):
            path = os.path.join(d, label[5:])
            with open(path, "w", newline="") as f:
                f.write(value if value.endswith("\n") else value + "\n")
            os.chmod(path, 0o600)
            env[label[5:]] = path
        elif label == "ssh-key":
            sock = os.path.join(d, "agent.sock")
            agents.append(subprocess.Popen(["ssh-agent", "-D", "-a", sock], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            for _ in range(50):
                if os.path.exists(sock):
                    break
                time.sleep(0.05)
            subprocess.run(["ssh-add", "-q", "-"], input=(value if value.endswith("\n") else value + "\n").encode(), env={**os.environ, "SSH_AUTH_SOCK": sock},
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
            env["SSH_AUTH_SOCK"] = sock
        else:
            env[label] = value
    return env


def http_main(argv):
    """auth http NAME METHOD PATH [-H 'Name: value']... [--data TEXT | --data-file FILE|-]: the module makes the request with the credential
    added and answers with the response only; the body goes to stdout. Exit: 0 for status < 400, 22 for >= 400 (status on stderr), 1 refused, 2 error."""
    import argparse, base64
    p = argparse.ArgumentParser(prog="auth http")
    p.add_argument("name")
    p.add_argument("method")
    p.add_argument("path")
    p.add_argument("-H", "--header", action="append", default=[])
    p.add_argument("--data")
    p.add_argument("--data-file")
    p.add_argument("--timeout", type=int)
    a = p.parse_args(argv)
    request = {"op": "http", "name": a.name, "method": a.method.upper(), "path": a.path, "cwd": os.getcwd()}
    if a.header:
        request["headers"] = {k.strip(): v.strip() for k, v in (h.split(":", 1) for h in a.header)}
    data = a.data.encode() if a.data is not None else (sys.stdin.buffer.read() if a.data_file == "-" else open(a.data_file, "rb").read() if a.data_file else None)
    if data is not None:
        request["body"] = base64.b64encode(data).decode()
    if a.timeout:
        request["timeout_sec"] = a.timeout
    try:
        resp = ask(request)
    except (OSError, ValueError):
        sys.exit("The authentication module is not running.")
    if resp.get("outcome") != "granted":
        print(resp.get("error", "Refused."), file=sys.stderr)
        return 2 if resp.get("outcome") == "error" else 1
    sys.stdout.buffer.write(base64.b64decode(resp.get("body", "")))
    sys.stdout.buffer.flush()
    if resp.get("truncated"):
        print("(response cut at the module's limit)", file=sys.stderr)
    print(f"HTTP {resp['status']}", file=sys.stderr)  # every response: a caller must see 200 / 204 / 4xx apart without the body
    for name, value in resp.get("headers", {}).items():
        if name == "retry-after" or "ratelimit" in name:
            print(f"{name}: {value}", file=sys.stderr)
    return 22 if resp["status"] >= 400 else 0


def run_main(argv):
    """auth run NAME: the module runs the item's fixed command with its secrets; stdin goes in, stdout and stderr come back as they are, the exit code is the command's.
    Exit: the command's code (124/125 = stopped by the module), 1 refused, 2 error."""
    import struct, threading
    if len(argv) != 1 or argv[0].startswith("-"):
        sys.exit("usage: auth run NAME < input > output")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    s.sendall((json.dumps({"op": "run", "name": argv[0], "cwd": os.getcwd()}) + "\n").encode())
    line = b""
    while not line.endswith(b"\n"):  # one byte at a time: nothing after the answer line may be read here
        c = s.recv(1)
        if not c:
            sys.exit("The authentication module is not running.")
        line += c
    resp = json.loads(line)
    if resp.get("outcome") != "granted":
        print(resp.get("error", "Refused."), file=sys.stderr)
        return 2 if resp.get("outcome") == "error" else 1

    def feed():
        try:
            while True:
                chunk = sys.stdin.buffer.read1(65536)
                if not chunk:
                    break
                s.sendall(chunk)
        except OSError:
            pass
        try:
            s.shutdown(socket.SHUT_WR)  # end of input; the output still comes back
        except OSError:
            pass

    threading.Thread(target=feed, daemon=True).start()

    def take(n):
        data = b""
        while len(data) < n:
            chunk = s.recv(n - len(data))
            if not chunk:
                return None
            data += chunk
        return data

    while True:
        head = take(5)
        if head is None:
            print("The run ended without an exit code.", file=sys.stderr)
            return 2
        tag, size = head[0], struct.unpack(">I", head[1:])[0]
        data = take(size) if size else b""
        if data is None:
            return 2
        if tag == 1:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
        elif tag == 2:
            sys.stderr.buffer.write(data)
            sys.stderr.buffer.flush()
        elif tag == 3:
            return int(data or b"2")


def serve_main(argv):
    """auth serve NAME [--listen 127.0.0.1:PORT]: a loopback HTTP forwarder. Every request it gets goes to the module as 'http-stream' (item "http NAME"), which adds the credential and pipes
    the response back as it comes (SSE, streamable HTTP). The client behind it sends no credential. Up to 16 requests at once; loopback only; nothing is logged."""
    import argparse, base64, http.server, socketserver, struct, threading
    p = argparse.ArgumentParser(prog="auth serve")
    p.add_argument("name")
    p.add_argument("--listen", default="127.0.0.1:0")
    a = p.parse_args(argv)
    host, _, port = a.listen.rpartition(":")
    if host not in ("127.0.0.1", "localhost", "::1"):
        sys.exit("auth serve listens on loopback only")
    slots = threading.BoundedSemaphore(16)
    SKIP_REQUEST = {"host", "connection", "content-length", "transfer-encoding", "authorization", "proxy-authorization", "accept-encoding"}
    SKIP_RESPONSE = {"connection", "transfer-encoding", "content-length", "keep-alive"}

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.0"  # the response ends when the connection closes: no length needed for a stream

        def log_message(self, *args):
            pass

        def fail(self, code, text):
            self.send_response(code)
            self.send_header("content-type", "text/plain")
            self.end_headers()
            self.wfile.write(text.encode())

        def handle_any(self):
            if not slots.acquire(blocking=False):
                return self.fail(503, "busy")
            try:
                size = int(self.headers.get("content-length") or 0)
                if size > 9 << 20:
                    return self.fail(413, "body too large")
                body = self.rfile.read(size) if size else b""
                request = {"op": "http-stream", "name": a.name, "method": self.command, "path": self.path, "cwd": os.getcwd(),
                           "headers": {k: v for k, v in self.headers.items() if k.lower() not in SKIP_REQUEST}}
                if body:
                    request["body"] = base64.b64encode(body).decode()
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                try:
                    s.connect(SOCK)
                except OSError:
                    return self.fail(503, "The authentication module is not running.")
                s.sendall((json.dumps(request) + "\n").encode())
                line = b""
                while not line.endswith(b"\n"):
                    c = s.recv(1)
                    if not c:
                        return self.fail(503, "The authentication module is not running.")
                    line += c
                resp = json.loads(line)
                if resp.get("outcome") != "granted":
                    return self.fail(403 if resp.get("outcome") != "error" else 502, resp.get("error", "Refused."))

                def take(n):
                    data = b""
                    while len(data) < n:
                        chunk = s.recv(n - len(data))
                        if not chunk:
                            return None
                        data += chunk
                    return data

                started = False
                while True:
                    head = take(5)
                    if head is None:
                        break
                    tag, n = head[0], struct.unpack(">I", head[1:])[0]
                    data = take(n) if n else b""
                    if data is None:
                        break
                    if tag == 5:
                        info = json.loads(data)
                        self.send_response(info["status"])
                        for k, v in info["headers"].items():
                            if k.lower() not in SKIP_RESPONSE:
                                self.send_header(k, v)
                        self.end_headers()
                        started = True
                    elif tag == 1 and started:
                        self.wfile.write(data)
                        self.wfile.flush()
                    elif tag == 3:
                        break
                if not started:
                    self.fail(502, "The module ended the request.")
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                slots.release()

        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = handle_any

    class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True

    server = Server((host, int(port)), Handler)
    print(f"auth serve {a.name} on {host}:{server.server_address[1]}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def sign_main(argv):
    """auth sign NAME [--digest] [--data-file FILE|-]: the module signs the bytes (stdin by default) with the key of item "signkey NAME" and answers with the signature only;
    it is printed as base64 on stdout. The key never leaves the module. Exit: 0 signed, 1 refused, 2 error."""
    import argparse, base64
    p = argparse.ArgumentParser(prog="auth sign")
    p.add_argument("name")
    p.add_argument("--data-file")
    p.add_argument("--digest", action="store_true", help="the input is a 32-byte SHA-256 digest (RSA key): sign it as it is")
    a = p.parse_args(argv)
    data = open(a.data_file, "rb").read() if a.data_file and a.data_file != "-" else sys.stdin.buffer.read()
    try:
        resp = ask({"op": "sign-digest" if a.digest else "sign", "name": a.name, "data": base64.b64encode(data).decode(), "cwd": os.getcwd()})
    except (OSError, ValueError):
        sys.exit("The authentication module is not running.")
    if resp.get("outcome") != "granted":
        print(resp.get("error", "Refused."), file=sys.stderr)
        return 2 if resp.get("outcome") == "error" else 1
    print(resp["data"])
    return 0


def serve_agent(recv, send, names, cwd):
    """The two ssh-agent requests a client needs (list keys 0x0b, sign 0x0d), answered by the module; everything else is a failure. recv(n) returns up to n bytes (b'' at the end), send(bytes) writes.
    No key is ever here: only public key blobs and signatures come back from the module."""
    import base64, struct
    identities = {}  # public key blob -> name; filled when the client asks for the list

    def key_ask(op, name, **extra):
        nonlocal tried
        tried = name
        resp = ask({"op": op, "name": name, "cwd": cwd, **extra})
        return base64.b64decode(resp["data"]) if resp.get("outcome") == "granted" else None

    def read_exact(n):
        out = b""
        while len(out) < n:
            chunk = recv(n - len(out))
            if not chunk:
                return None
            out += chunk
        return out

    while True:
        head = read_exact(4)
        if head is None:
            return
        size = struct.unpack(">I", head)[0]
        if size > 262144:  # an agent request is small; refuse to buffer anything bigger
            return
        body = read_exact(size)
        if body is None:
            return
        out, why, tried = b"\x05", "not granted or key not listed", None  # SSH_AGENT_FAILURE
        try:
            if body[:1] == b"\x0b":  # list identities
                keys = []
                for name in names:
                    blob = key_ask("ssh-identity", name)
                    if blob:
                        identities[blob] = name
                        keys.append(struct.pack(">I", len(blob)) + blob + struct.pack(">I", len(name)) + name.encode())
                out = b"\x0c" + struct.pack(">I", len(keys)) + b"".join(keys)
            elif body[:1] == b"\x0d":  # sign request: string key, string data, uint32 flags
                n = struct.unpack(">I", body[1:5])[0]
                blob = body[5:5 + n]
                m = struct.unpack(">I", body[5 + n:9 + n])[0]
                data = body[9 + n:9 + n + m]
                flags = struct.unpack(">I", body[9 + n + m:13 + n + m])[0]
                if blob in identities:
                    sig = key_ask("ssh-sign", identities[blob], data=base64.b64encode(data).decode(), flags=flags)
                    if sig:
                        out = b"\x0e" + struct.pack(">I", len(sig)) + sig
        except (OSError, ValueError, struct.error, KeyError) as e:
            out, why = b"\x05", type(e).__name__
        if out == b"\x05":  # one line per failed list or sign, no data, so the holder log shows why the client was refused
            print(f"auth agent: {'list' if body[:1] == b'\x0b' else 'sign' if body[:1] == b'\x0d' else 'other'} {tried or '-'}: {why}", file=sys.stderr, flush=True)
        send(struct.pack(">I", len(out)) + out)


def ssh_stdio_main(argv):
    """auth ssh-stdio NAME[,NAME...]: the same agent on stdin and stdout, for a forced command (a restricted entry key on this host serves a remote machine that has no module socket).
    The remote forwarder carries these bytes over the ssh connection and presents them to its ssh client as an agent."""
    if len(argv) != 1 or not argv[0]:
        sys.exit("usage: auth ssh-stdio NAME[,NAME...]")
    stdin, stdout = sys.stdin.buffer, sys.stdout.buffer

    def send(data):
        stdout.write(data)
        stdout.flush()

    serve_agent(stdin.read1, send, argv[0].split(","), os.getcwd())
    return 0


def ssh_main(argv):
    """auth ssh NAME[,NAME...] -- COMMAND...: runs the command with SSH_AUTH_SOCK set to a per-run agent socket. The socket only forwards the two agent requests
    (list keys, sign) to the module, which holds the key; no key is in this process, a file or the command's environment. The socket is removed when the command ends."""
    if "--" not in argv or len(argv) < 3 or argv.index("--") != 1:
        sys.exit("usage: auth ssh NAME[,NAME...] -- COMMAND...")
    names, command = argv[0].split(","), argv[2:]
    cwd = os.getcwd()
    def serve(conn):
        with conn:
            serve_agent(lambda n: conn.recv(n), conn.sendall, names, cwd)

    d = scratch()
    path = os.path.join(d, "agent.sock")
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(path)
    os.chmod(path, 0o600)
    listener.listen(8)

    def accept():
        while True:
            try:
                conn, _ = listener.accept()
            except OSError:
                return
            threading.Thread(target=serve, args=(conn,), daemon=True).start()

    threading.Thread(target=accept, daemon=True).start()
    child = []

    def stop(sig, _):
        if not child:
            sys.exit(128 + sig)
        t = threading.Timer(1, lambda: child[0].poll() is None and child[0].send_signal(sig))
        t.daemon = True
        t.start()

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, stop)
    try:
        try:
            child.append(subprocess.Popen(command, env={**os.environ, "SSH_AUTH_SOCK": path}))
        except OSError:
            sys.exit("The command could not be started.")
        return child[0].wait()
    finally:
        listener.close()
        shutil.rmtree(d, ignore_errors=True)


def gmail_main(argv):
    """auth gmail list|get|modify NAME [--q Q] [--max-results N] [--page-token T] [--id ID] [--format full|metadata|minimal] [--add-labels A,B] [--remove-labels C]
    The module holds the OAuth secrets and makes the fixed Gmail API call; Google's body is printed on stdout unchanged, exit 0 for status < 400, 22 for >= 400 (status on stderr), 1 refused, 2 error."""
    import argparse
    p = argparse.ArgumentParser(prog="auth gmail")
    p.add_argument("action", choices=["list", "get", "modify"])
    p.add_argument("name")
    for opt in ("q", "page-token", "id", "format", "add-labels", "remove-labels"):
        p.add_argument("--" + opt)
    p.add_argument("--max-results", type=int)
    a = p.parse_args(argv)
    request = {"op": "gmail-" + a.action, "name": a.name, "cwd": os.getcwd()}
    for key, value in (("q", a.q), ("max_results", a.max_results), ("page_token", a.page_token), ("id", a.id), ("format", a.format)):
        if value is not None:
            request[key] = value
    for key, value in (("add_labels", a.add_labels), ("remove_labels", a.remove_labels)):
        if value:
            request[key] = value.split(",")
    try:
        resp = ask(request)
    except (OSError, ValueError):
        sys.exit("The authentication module is not running.")
    if resp.get("outcome") != "granted":
        print(resp.get("error", "Refused."), file=sys.stderr)
        return 2 if resp.get("outcome") == "error" else 1
    sys.stdout.write(resp.get("body", ""))
    if resp["status"] >= 400:
        print(f"HTTP {resp['status']}", file=sys.stderr)
        return 22
    return 0


def mail_main(argv):
    """auth mail read NAME [--folders] [--mailbox M|*] [--unseen] [--since D] [--before D] [--from X] [--search-subject X] [--order newest|oldest] [--limit N] [--fetch none|headers|text|raw] [--uid N]
    reads read-only (nothing is marked seen) and prints one JSON line {folders|messages, truncated?}.
    auth mail sort NAME --uid N --uidvalidity N [--add KW,KW] [--archive]: adds the item's allowed keywords and/or moves the message to the Archive folder (one message, the item's mailbox).
    auth mail check NAME --protocol imap993|smtp465|smtp587-starttls: logs in on that public port with verification, nothing sent or read.
    auth mail send NAME --to ADDR[,ADDR...] --subject TEXT [--from-name TEXT] [--reply-to ADDR] [--html-file FILE]  (the text body from stdin)
    The module logs in to the item's SMTP server and sends; the password never reaches this process. Prints the message id. Exit: 0 sent, 1 refused, 2 error;
    on error the class (MAIL_NOT_SUBMITTED: retry is safe, MAIL_REJECTED: do not retry, MAIL_UNKNOWN: never retry) is printed on stderr."""
    import argparse
    p = argparse.ArgumentParser(prog="auth mail")
    p.add_argument("action", choices=["send", "read", "sort", "check"])
    p.add_argument("name")
    p.add_argument("--to")
    p.add_argument("--subject")
    for opt in ("mailbox", "order", "fetch", "since", "before", "from", "search-subject"):
        p.add_argument("--" + opt)
    p.add_argument("--limit", type=int)
    p.add_argument("--uid", type=int)
    p.add_argument("--unseen", action="store_true")
    p.add_argument("--uidvalidity", type=int)
    p.add_argument("--add")
    p.add_argument("--archive", action="store_true")
    p.add_argument("--protocol", choices=["imap993", "smtp465", "smtp587-starttls"])
    p.add_argument("--folders", action="store_true")
    p.add_argument("--from-name")
    p.add_argument("--reply-to")
    p.add_argument("--html-file")
    a = p.parse_args(argv)
    if a.action in ("sort", "check"):
        request = {"op": "mail-" + a.action, "name": a.name, "cwd": os.getcwd()}
        if a.action == "sort":
            request.update({"uid": a.uid, "uidvalidity": a.uidvalidity, **({"add": a.add.split(",")} if a.add else {}), **({"archive": True} if a.archive else {})})
        else:
            request["protocol"] = a.protocol
        try:
            resp = ask(request)
        except (OSError, ValueError):
            sys.exit("The authentication module is not running.")
        if resp.get("outcome") != "granted":
            print(resp.get("error", "Refused."), file=sys.stderr)
            return 2 if resp.get("outcome") == "error" else 1
        print(json.dumps({k: resp[k] for k in ("flagged", "moved", "tls_verified") if k in resp}))
        return 0
    if a.action == "read":
        search = {k: v for k, v in (("since", a.since), ("before", a.before), ("from", getattr(a, "from")), ("subject", a.search_subject)) if v}
        if a.unseen:
            search["unseen"] = True
        request = {"op": "mail-read", "name": a.name, "cwd": os.getcwd(), **{k: v for k, v in (("mailbox", a.mailbox), ("order", a.order), ("fetch", a.fetch), ("limit", a.limit), ("uid", a.uid), ("search", search or None), ("folders", True if a.folders else None)) if v is not None}}
        try:
            resp = ask(request)
        except (OSError, ValueError):
            sys.exit("The authentication module is not running.")
        if resp.get("outcome") != "granted":
            print(resp.get("error", "Refused."), file=sys.stderr)
            return 2 if resp.get("outcome") == "error" else 1
        print(json.dumps({k: resp[k] for k in ("folders", "messages", "truncated") if k in resp}))
        return 0
    if not a.to or not a.subject:
        sys.exit("auth mail send needs --to and --subject")
    request = {"op": "mail-send", "name": a.name, "to": a.to.split(","), "subject": a.subject, "text": sys.stdin.read(), "cwd": os.getcwd()}
    if a.from_name:
        request["from_name"] = a.from_name
    if a.reply_to:
        request["reply_to"] = a.reply_to
    if a.html_file:
        request["html"] = open(a.html_file, encoding="utf-8").read()
    try:
        resp = ask(request)
    except (OSError, ValueError):
        sys.exit("The authentication module is not running.")
    if resp.get("outcome") != "granted":
        print(resp.get("error", "Refused."), file=sys.stderr)
        return 2 if resp.get("outcome") == "error" else 1
    print(resp.get("message_id", ""))
    return 0


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "ssh-stdio":
        return ssh_stdio_main(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "gmail":
        return gmail_main(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "mail":
        return mail_main(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "ssh":
        return ssh_main(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "sign":
        return sign_main(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "serve":
        return serve_main(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "run":
        return run_main(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "http":
        return http_main(sys.argv[2:])
    if len(sys.argv) < 3 or sys.argv[1] != "exec":
        sys.exit("usage: auth exec COMMAND... [-- ARGS...]")
    command, args = sys.argv[2:], []
    if "--" in command:
        i = command.index("--")
        command, args = command[:i], command[i + 1:]
    if not command:
        sys.exit("usage: auth exec COMMAND... [-- ARGS...]")
    try:
        resp = ask({"op": "exec", "command": command, "cwd": os.getcwd()})
    except (OSError, ValueError):
        sys.exit("The authentication module is not running.")
    if resp.get("outcome") != "granted":
        print(resp.get("error", "Refused."), file=sys.stderr)
        return 2 if resp.get("outcome") == "error" else 1
    child, agents, d = [], [], scratch()

    def stop(sig, _):
        if not child:
            sys.exit(128 + sig)
        # The command usually got the same signal from its group (terminal, systemd); pass it on only if it still runs after 1 s.
        t = threading.Timer(1, lambda: child[0].poll() is None and child[0].send_signal(sig))
        t.daemon = True
        t.start()

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, stop)
    try:
        try:
            extra = hand_over(resp["env"], d, agents)
        except (OSError, subprocess.CalledProcessError):
            sys.exit("The secret could not be handed over.")
        try:
            # The caller's environment passes through (e.g. GIT_COMMIT_SHA for docker compose); item fields are added on top.
            child.append(subprocess.Popen(command + args, env={**os.environ, **extra}))
        except OSError:
            sys.exit("The command could not be started.")
        return child[0].wait()
    finally:  # the temp folder and the per-run agent never outlive the command (also on SIGINT/SIGTERM)
        for a in agents:
            a.terminate()
            a.wait()
        shutil.rmtree(d, ignore_errors=True)


if __name__ == "__main__":
    code = main()
    if code < 0:  # the command died by a signal: die by the same one, so systemd sees a clean stop
        signal.signal(-code, signal.SIG_DFL)
        os.kill(os.getpid(), -code)
    raise SystemExit(code)
