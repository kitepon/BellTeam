<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Every Button of the app carries the "plain" class: Fluent's own hover and pressed colours are replaced by an opacity change, like Theme.xaml. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Noto Sans CJK JP, sans-serif"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="#21293D"/>
    <Setter Property="Background" Value="#F8F8FB"/>
  </Style>
  <Style Selector="Button.plain">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}"/>
    <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
    <Setter Property="Opacity" Value="0.82"/>
  </Style>
  <Style Selector="Button.plain:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}"/>
    <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>
  <Style Selector="Button.plain:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}"/>
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
  <!-- A conversation row of the sidebar: transparent, white while selected, a faint wash on hover. -->
  <Style Selector="Button.row">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="10,12"/>
    <Setter Property="Margin" Value="8,2"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#66FFFFFF"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.row.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- A text box without Fluent's chrome (search, composer). -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Foreground" Value="#21293D"/>
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
</Styles>
