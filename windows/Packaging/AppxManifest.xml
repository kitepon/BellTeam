<?xml version="1.0" encoding="utf-8"?>
<!-- Sparse package: gives the installed BellTeam.exe (outside the package, uap10:AllowExternalContent) an identity so Windows lists it in the share sheet.
     Built, signed and registered by scripts/register-windows-share-target.ps1. Publisher must equal the signing certificate's subject. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 rescap">
  <Identity Name="BellTeam.Windows" Publisher="CN=BellTeam" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>BellTeam</DisplayName>
    <PublisherDisplayName>kitepon</PublisherDisplayName>
    <Logo>Assets\BellTeam.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="ja-jp" />
  </Resources>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="BellTeam" Executable="BellTeam.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="BellTeam" Description="BellTeam" BackgroundColor="transparent" Square150x150Logo="Assets\BellTeam.png" Square44x44Logo="Assets\BellTeam.png" AppListEntry="none" />
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="BellTeamの担当へ共有">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>Text</uap:DataFormat>
            <uap:DataFormat>URI</uap:DataFormat>
            <uap:DataFormat>Bitmap</uap:DataFormat>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
