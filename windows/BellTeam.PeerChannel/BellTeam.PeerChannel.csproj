<Project Sdk="Microsoft.NET.Sdk">
  <!-- peer-channel pc/1 device part in C# (contract 0.5.8, kitepon/peer-channel 2df08c1). Platform-neutral: Windows and Linux (Neon) reuse it. -->
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BellTeam.Tests" />
    <InternalsVisibleTo Include="BellTeam.Linux.Tests" />
    <!-- The prebuilt x64 DLL (windows/native/README.md); an arm64 process cannot load it, so a win-arm64 publish carries none. -->
    <None Include="../native/prebuilt/win-x64/datachannel.dll" Condition="'$(RuntimeIdentifier)' != 'win-arm64'" Link="datachannel.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
