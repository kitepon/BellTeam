<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- login-billing 0.25.2 (contracts 1.60 and 1.61; text-only change to 0.25.1), accepted by Mint 2026-11-27: android/fetch-login-billing.sh puts the sha256-checked package here. -->
    <add key="login-billing-local" value="packages-local" />
    <!-- Approval Box client component 0.5.0 (.NET form, client-dotnet-v0.5.0): android/fetch-approval-box-client.sh puts the sha256-checked package here. -->
    <add key="approval-box-client-local" value="packages-approval-box" />
  </packageSources>
  <!-- Kitepon.LoginBilling.* comes only from the local, sha256-checked folder; a same-id package on nuget.org is never restored. -->
  <packageSourceMapping>
    <packageSource key="login-billing-local">
      <package pattern="Kitepon.LoginBilling.*" />
    </packageSource>
    <!-- Kitepon.ApprovalBox.* comes only from its own local, sha256-checked folder. -->
    <packageSource key="approval-box-client-local">
      <package pattern="Kitepon.ApprovalBox.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
