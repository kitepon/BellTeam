# Set the independent Bridge owner's public image reference (prefer its index digest).
CALL_BRIDGE_IMAGE=
# Use never for the Bridge owner's downloaded docker-load archives.
CALL_BRIDGE_PULL_POLICY=missing
# Choose your own authentication. A legacy bearer token or a tokens file is supported.
CALL_BRIDGE_TOKEN=
# Optional: put your existing tokens.json under runtime/call-bridge/auth/.
CALL_BRIDGE_TOKENS_FILE=
CALL_BRIDGE_BIND_IP=127.0.0.1
CALL_BRIDGE_PUBLISHED_PORT=18910
# Existing standalone directory configuration remains available.
CALL_BRIDGE_DIRECTORY_URL=
CALL_BRIDGE_DIRECTORY_UNIX=
