#!/usr/bin/env python3
"""The one way to lend or take back a broker key. The module accepts grant and revoke only from this program (its path and sha256 are registered),
and keeps the decision record in its audit. Sakura's seat-side checks (docs/grant-decision.md) run here before anything is sent.
usage: grant grant  (--bot ID [--cwd DIR] | --unit DIR) --role TEXT --record TEXT --need standing|one-off --reason TEXT [--until ISO] COMMAND
       grant revoke (--bot ID [--cwd DIR] | --unit DIR) --reason TEXT COMMAND"""
import argparse, json, os, socket, sys, uuid

SOCK = os.environ.get("AUTH_SOCK") or "/srv/bellteam/shared/tools/auth-mediation/container.sock"
p = argparse.ArgumentParser()
p.add_argument("action", choices=["grant", "revoke"])
w = p.add_mutually_exclusive_group(required=True)
w.add_argument("--bot")
w.add_argument("--unit")
p.add_argument("--cwd")
p.add_argument("--until")
p.add_argument("--role", help="requester's role as read with get_bot (or the unit's product owner)")
p.add_argument("--record", help="chart tasks / audit lines showing how often they use it")
p.add_argument("--need", choices=["standing", "one-off"])
p.add_argument("--reason", required=True)
p.add_argument("command", help='the item name = the command as typed, one quoted string')
a = p.parse_args()
if not a.reason.strip():
    sys.exit("grant-decision: --reason is empty")
if a.action == "grant":
    missing = [f for f in ("role", "record", "need") if not (getattr(a, f) or "").strip()]
    if missing:
        sys.exit(f"grant-decision: fill {', '.join('--' + m for m in missing)} first (docs/grant-decision.md)")
    if a.need == "standing" and a.until:
        sys.exit("grant-decision: a standing need gets no expiry")
    if a.need == "one-off" and not a.until:
        sys.exit("grant-decision: a one-off grant needs --until (end of its task, or 30 days)")
decision = {"id": str(uuid.uuid4()), "reason": a.reason, **({k: getattr(a, k) for k in ("role", "record", "need")} if a.action == "grant" else {})}
args = {"command": a.command, "decision": decision, **({"bot": a.bot} if a.bot else {"unit": a.unit}), **({"cwd": a.cwd} if a.cwd else {}),
        **({"expires": a.until} if a.until and a.action == "grant" else {})}
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)  # this process is the peer the module identifies, so it talks to the socket itself
s.settimeout(60)
try:
    s.connect(SOCK)
except OSError:
    sys.exit("The authentication module is not running.")
s.sendall((json.dumps({"op": "admin", "verb": a.action, "args": args}) + "\n").encode())
resp = json.loads(s.makefile().readline())
if resp.get("outcome") != "ok":
    sys.exit(resp.get("error", "Refused."))
print(json.dumps({"change": a.action, "command": a.command, "decision": decision["id"]}))
