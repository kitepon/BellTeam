{
  "note": "Throughline 0.20.0: `throughline harness-entries --json` (e1) and the hook files left by `throughline install` + the old RTK pass (after), frozen 2026-11-14",
  "e1": {
    "schema": "bellteam.harness-entries.v1",
    "product": "throughline",
    "version": "0.20.0",
    "mcpServers": {},
    "hooks": {
      "claude": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "throughline session-start"
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "throughline process-turn",
                "async": true
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "throughline prompt-submit"
              }
            ]
          }
        ]
      },
      "codex": {
        "PreCompact": [
          {
            "matcher": "auto",
            "hooks": [
              {
                "type": "command",
                "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook pre-compact",
                "timeout": 30,
                "async": false,
                "statusMessage": "Throughline: 自動継続を準備"
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook user-prompt-submit",
                "timeout": 30,
                "async": false,
                "statusMessage": null
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook post-tool-use",
                "timeout": 30,
                "async": false,
                "statusMessage": null
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook stop",
                "timeout": 300,
                "async": false,
                "statusMessage": null
              }
            ]
          }
        ]
      },
      "cursor": {
        "sessionStart": [
          {
            "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs session-start",
            "timeout": 10
          }
        ],
        "beforeSubmitPrompt": [
          {
            "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs prompt-submit",
            "timeout": 30
          }
        ],
        "stop": [
          {
            "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs process-turn",
            "timeout": 300
          }
        ]
      },
      "grok": {
        "hooks": {
          "SessionStart": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs session-start",
                  "timeout": 10
                }
              ]
            }
          ],
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs prompt-submit",
                  "timeout": 30
                }
              ]
            }
          ],
          "Stop": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs process-turn",
                  "timeout": 300,
                  "async": true
                }
              ]
            }
          ]
        }
      }
    },
    "permissions": {},
    "settings": {
      "codex": {
        "features.hooks": true
      }
    },
    "owns": {
      "commandIncludes": [
        "throughline.mjs",
        "throughline process-turn",
        "throughline session-start",
        "throughline prompt-submit",
        "throughline pre-compact",
        "throughline pre-tool-use",
        "throughline claude-forward-wait",
        "throughline inject-context",
        "throughline capture-tool",
        "node src/detail-capture.mjs",
        "node src/classifier.mjs",
        "node src/turn-processor.mjs",
        "node src/context-injector.mjs",
        "throughline codex-hook stop",
        "throughline codex-hook user-prompt-submit",
        "throughline codex-hook post-tool-use",
        "throughline codex-hook pre-compact"
      ]
    }
  },
  "after": {
    ".claude/settings.json": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"throughline session-start\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"throughline process-turn\",\n            \"async\": true\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"throughline prompt-submit\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node /srv/bellteam/shared/tools/testgate/current/bin/testgate.mjs hook claude\"\n          }\n        ]\n      }\n    ]\n  }\n}\n",
    ".codex/hooks.json": "{\n  \"hooks\": {\n    \"PreCompact\": [\n      {\n        \"matcher\": \"auto\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook pre-compact\",\n            \"timeout\": 30,\n            \"async\": false,\n            \"statusMessage\": \"Throughline: 自動継続を準備\"\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook user-prompt-submit\",\n            \"timeout\": 30,\n            \"async\": false,\n            \"statusMessage\": null\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook post-tool-use\",\n            \"timeout\": 30,\n            \"async\": false,\n            \"statusMessage\": null\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs codex-hook stop\",\n            \"timeout\": 300,\n            \"async\": false,\n            \"statusMessage\": null\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node /srv/bellteam/shared/tools/testgate/current/bin/testgate.mjs hook codex\"\n          }\n        ]\n      }\n    ]\n  }\n}\n",
    ".cursor/hooks.json": "{\n  \"version\": 1,\n  \"hooks\": {\n    \"sessionStart\": [\n      {\n        \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs session-start\",\n        \"timeout\": 10\n      }\n    ],\n    \"beforeSubmitPrompt\": [\n      {\n        \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs prompt-submit\",\n        \"timeout\": 30\n      }\n    ],\n    \"stop\": [\n      {\n        \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs process-turn\",\n        \"timeout\": 300\n      }\n    ],\n    \"preToolUse\": [\n      {\n        \"command\": \"node /srv/bellteam/shared/tools/testgate/current/bin/testgate.mjs hook cursor\",\n        \"matcher\": \"Shell\"\n      }\n    ]\n  }\n}\n",
    ".grok/hooks/throughline.json": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs session-start\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs prompt-submit\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"/usr/local/bin/node /usr/local/lib/node_modules/throughline/bin/throughline.mjs process-turn\",\n            \"timeout\": 300,\n            \"async\": true\n          }\n        ]\n      }\n    ]\n  }\n}\n",
    ".grok/hooks/rtk.json": "{\n  \"hooks\": {\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"^run_terminal_command$\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node /srv/bellteam/shared/tools/testgate/current/bin/testgate.mjs hook grok\",\n            \"timeout\": 5,\n            \"env\": {\n              \"RTK_BIN\": \"/usr/local/bin/rtk\"\n            }\n          }\n        ]\n      }\n    ]\n  }\n}\n"
  }
}
